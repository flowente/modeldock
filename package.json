{
  "name": "modeldock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @modeldock/api --filter @modeldock/web dev",
    "lint": "pnpm -r --if-present typecheck",
    "preview": "pnpm --filter @modeldock/web preview",
    "test": "vitest run --config vitest.config.mjs --configLoader runner",
    "test:watch": "vitest --config vitest.config.mjs --configLoader runner",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}

# ModelDock local environment
# Copy this file to .env and fill only the values you need.
# Never commit real passwords or keys.

# API (it also serves the chat at http://127.0.0.1:4317/)
MODELDOCK_API_HOST=127.0.0.1
MODELDOCK_API_PORT=4317

# Accounts: every API call needs a signed-in account. "false" opens the API (tests only).
MODELDOCK_REQUIRE_LOGIN=true
# Where accounts, permissions, conversations and the audit log are kept. Default: data/modeldock.db
MODELDOCK_DATABASE_PATH=

# Connection between devices (modeldock-link): other computers and phones on the same network.
# "false" switches it off.
MODELDOCK_LINK=true
MODELDOCK_LINK_PORT=4319
# A phone's browser on the same Wi-Fi may enter without the ModelDock Link client, still behind
# the login. "false" lets in only devices joined with an invitation.
MODELDOCK_LINK_ALLOW_BROWSERS=true

# Ollama
# fake = deterministic demo data
# real = require Ollama API
# auto = use the local Ollama
MODELDOCK_OLLAMA_MODE=auto
MODELDOCK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ModelDock local environment
# Copy this file to .env and fill only the values you need.
# Never commit real API tokens, passwords or auth keys.

# API
MODELDOCK_API_HOST=127.0.0.1
MODELDOCK_API_PORT=4317

# Ollama
# fake = deterministic demo data
# real = require Ollama API
# auto = try real Ollama first, then fall back where supported
MODELDOCK_OLLAMA_MODE=auto
MODELDOCK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Tailscale
# fake = deterministic demo data
# cli = local tailscale CLI/status
# api = Tailscale HTTP API using the token below
# auto = API if token exists, otherwise CLI
# `auto` uses the local CLI for setup and the API only when a token is supplied.
MODELDOCK_TAILSCALE_MODE=auto
MODELDOCK_TAILSCALE_TAILNET=-
MODELDOCK_TAILSCALE_API_BASE_URL=https://api.tailscale.com/api/v2
MODELDOCK_TAILSCALE_API_TOKEN=

# Open WebUI
# Used by the backend setup and health checks.
# Leave blank: guided setup uses http://127.0.0.1:8080 and saves it here.
MODELDOCK_OPENWEBUI_BASE_URL=
# Admin API key generated inside Open WebUI Settings > Account.
# It is used server-side to verify admin access and, later, manage users/groups/model permissions.
MODELDOCK_OPENWEBUI_API_KEY=
# Optional override for self-hosted or development runtime manifests.
# By default ModelDock downloads the signed-by-checksum runtime pack from its GitHub Release.
MODELDOCK_OPENWEBUI_RUNTIME_MANIFEST_URL=
